{
  "models": ["opus", "sonnet", "haiku", "fable"],
  "escalation": {
    "ceiling": "xhigh",
    "levels": ["low", "medium", "high", "xhigh", "max"]
  },
  "classes": {
    "coordinator": { "model": "opus", "effort": "medium", "use": "Run and wave coordinators, orchestration sessions" },
    "planning": { "model": "opus", "effort": "high", "use": "Planner seats, specifications, task scope" },
    "planning-high-stakes": { "model": "fable", "effort": "high", "use": "Architecture decisions and other high-stakes planning" },
    "implementation": { "model": "sonnet", "effort": "medium", "use": "Well-specified implementation work" },
    "implementation-complex": { "model": "opus", "effort": "medium", "use": "Complex or cross-cutting implementation" },
    "test-authoring": { "model": "sonnet", "effort": "medium", "use": "Independent test authors" },
    "review": { "model": "opus", "effort": "high", "use": "Reviewer seats and defect search" },
    "review-high-stakes": { "model": "fable", "effort": "high", "use": "Review of high-stakes changes" },
    "research": { "model": "sonnet", "effort": "medium", "use": "Read-only research and exploration" },
    "bulk": { "model": "haiku", "effort": "medium", "use": "Bulk writes and other checkable mechanical work" },
    "extraction": { "model": "sonnet", "effort": "low", "use": "Extractors and retrospective data pulls" },
    "audit-measure": { "model": "haiku", "effort": "low", "use": "Deep-codebase-audit Measure: run the metrics script, return its digest" },
    "audit-review": { "model": "sonnet", "effort": "high", "use": "Deep-codebase-audit slice and gap reviewers (fan-out)" },
    "audit-verify-high": { "model": "opus", "effort": "medium", "use": "Deep-codebase-audit verification of high and critical findings" },
    "audit-synthesis": { "model": "opus", "effort": "medium", "use": "Deep-codebase-audit report synthesis" }
  },
  "tiers": {
    "thresholds": { "directMaxFiles": 2, "delegatedMaxFiles": 10 },
    "rows": {
      "Direct": { "criteria": "known fix, no migration/new API", "pipeline": "Orchestrator edits, tests, reviews inline" },
      "Delegated": { "criteria": "single logical unit, clear or explorable scope", "pipeline": "Single subagent, separate review agent" },
      "Parallel": { "criteria": "multiple independent work streams, dependency edges", "pipeline": "Worktree agents, full pipeline" }
    },
    "forceUp": [
      { "when": "Database migration", "bound": "min", "tier": "Delegated" },
      { "when": "New public API surface", "bound": "min", "tier": "Delegated" },
      { "when": "Multiple independent work streams", "bound": "exact", "tier": "Parallel" },
      { "when": "User says \"let's plan\" / collaborative language", "bound": "min", "tier": "Delegated" }
    ],
    "forceDown": [
      { "when": "User says \"just fix it\" / \"quick\"", "bound": "exact", "tier": "Direct", "note": "unless complexity contradicts" },
      { "when": "The item's type resolves to the `default` schema, or the item is schema-free", "bound": "eligible", "tier": "Direct" }
    ]
  }
}
