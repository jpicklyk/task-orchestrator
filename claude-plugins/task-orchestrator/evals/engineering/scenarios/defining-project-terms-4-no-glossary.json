{
  "id": "defining-project-terms-4-no-glossary",
  "skill": "defining-project-terms",
  "kind": "build",
  "title": "The same request in a project with no glossary",
  "fixture": "no-glossary",
  "pattern": "unrequested scope",
  "expectation": "The project has no glossary. The skill must stay silent: a run that creates a glossary or a decision record nobody asked for is a regression. This guards the other three scenarios' skill against over-triggering.",
  "prompt": "Add order history for customers: a customer can list their past orders, newest first, each with its date and total. Add tests.",
  "models": [
    "sonnet"
  ],
  "grading": "auto",
  "checks": [
    {
      "id": "T4a",
      "type": "new-file-matches",
      "regex": "glossary|decisions?/|(^|/)adr[-_./]",
      "pattern": "unrequested scope"
    },
    {
      "id": "T4b",
      "type": "added-matches",
      "regex": "glossary",
      "pattern": "unrequested scope"
    },
    {
      "id": "G1",
      "type": "narrating-comments",
      "in": "^src/",
      "pattern": "narrating or change-log comments"
    },
    {
      "id": "G2",
      "type": "swallowed-catch",
      "in": "^src/",
      "pattern": "empty, log-only or default-returning catch"
    },
    {
      "id": "G3",
      "type": "defensive-guards",
      "in": "^src/",
      "min": 3,
      "pattern": "defensive guards on guaranteed values"
    },
    {
      "id": "G4",
      "type": "added-matches",
      "in": "package\\.json$",
      "regex": "\"[^\"]+\"\\s*:\\s*\"[\\^~>=]*\\d",
      "pattern": "new dependency"
    },
    {
      "id": "G5",
      "type": "modified-outside",
      "regex": "^(src/orders/|test/)",
      "pattern": "scope creep: unrelated existing files changed"
    },
    {
      "id": "G6",
      "type": "unused-export",
      "in": "^src/",
      "pattern": "unused new export"
    },
    {
      "id": "G7",
      "type": "added-matches",
      "in": "^src/",
      "regex": "\\b(TODO|FIXME|XXX|HACK)\\b",
      "pattern": "TODO or FIXME left behind"
    }
  ]
}
