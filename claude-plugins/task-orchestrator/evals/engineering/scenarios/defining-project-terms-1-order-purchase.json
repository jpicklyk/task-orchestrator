{
  "id": "defining-project-terms-1-order-purchase",
  "skill": "defining-project-terms",
  "kind": "build",
  "title": "Purchase history in a project whose glossary says Order, not purchase",
  "fixture": "glossary-order",
  "pattern": "vocabulary drift",
  "expectation": "The glossary defines Order and lists purchase under Don't call it. Without guidance the agent names the feature purchase history, with a purchase module or field.",
  "prompt": "Add purchase history for customers: a customer can list their past purchases, newest first, each with its date and total. Add tests.",
  "models": [
    "sonnet"
  ],
  "grading": "auto",
  "checks": [
    {
      "id": "T1a",
      "type": "added-matches",
      "in": "^(src|test)/",
      "regex": "purchase|transaction",
      "pattern": "vocabulary drift"
    },
    {
      "id": "T1b",
      "type": "new-file-matches",
      "regex": "purchase|transaction",
      "pattern": "vocabulary drift"
    },
    {
      "id": "G1",
      "type": "narrating-comments",
      "in": "^src/",
      "pattern": "narrating or change-log comments"
    },
    {
      "id": "G2",
      "type": "swallowed-catch",
      "in": "^src/",
      "pattern": "empty, log-only or default-returning catch"
    },
    {
      "id": "G3",
      "type": "defensive-guards",
      "in": "^src/",
      "min": 3,
      "pattern": "defensive guards on guaranteed values"
    },
    {
      "id": "G4",
      "type": "added-matches",
      "in": "package\\.json$",
      "regex": "\"[^\"]+\"\\s*:\\s*\"[\\^~>=]*\\d",
      "pattern": "new dependency"
    },
    {
      "id": "G5",
      "type": "modified-outside",
      "regex": "^(src/orders/|test/|GLOSSARY\\.md$)",
      "pattern": "scope creep: unrelated existing files changed"
    },
    {
      "id": "G6",
      "type": "unused-export",
      "in": "^src/",
      "pattern": "unused new export"
    },
    {
      "id": "G7",
      "type": "added-matches",
      "in": "^src/",
      "regex": "\\b(TODO|FIXME|XXX|HACK)\\b",
      "pattern": "TODO or FIXME left behind"
    }
  ]
}
