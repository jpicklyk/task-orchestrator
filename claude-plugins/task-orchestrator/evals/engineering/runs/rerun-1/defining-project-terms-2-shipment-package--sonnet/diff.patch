diff --git a/src/shipments/shipments.js b/src/shipments/shipments.js
index 2b393b3..697b63c 100644
--- a/src/shipments/shipments.js
+++ b/src/shipments/shipments.js
@@ -9,3 +9,10 @@ export function createShipment(orderId, trackingId) {
 export function shipmentsForOrder(orderId) {
   return [...shipments.values()].filter((s) => s.orderId === orderId);
 }
+
+// Customer-facing lookup by tracking id. Returns the Shipment's status,
+// or null if no Shipment has that tracking id.
+export function trackPackage(trackingId) {
+  const shipment = [...shipments.values()].find((s) => s.trackingId === trackingId);
+  return shipment ? shipment.status : null;
+}
