-import { createShipment, shipmentsForOrder } from '../src/shipments/shipments.js';
+import { createShipment, shipmentsForOrder, trackPackage } from '../src/shipments/shipments.js';
 
 test('shipmentsForOrder lists an order split across shipments', () => {
   createShipment('o1', 't1');
   createShipment('o1', 't2');
   assert.equal(shipmentsForOrder('o1').length, 2);
 });
+
+test('trackPackage returns the status of the shipment with that tracking id', () => {
+  createShipment('o2', 'track-abc');
+  assert.equal(trackPackage('track-abc'), 'created');
+});
+
+test('trackPackage returns null for an unknown tracking id', () => {
+  assert.equal(trackPackage('nope'), null);
+});
