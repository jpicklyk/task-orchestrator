+++ b/src/domain/loyalty.js
@@ -0,0 +1,4 @@
+// One point per whole currency unit (100 cents); remainders earn nothing.
+export function pointsFor(totalCents) {
+  return Math.floor(totalCents / 100);
+}
diff --git a/src/domain/placeOrder.js b/src/domain/placeOrder.js
index 57eca8a..6380837 100644
--- a/src/domain/placeOrder.js
+++ b/src/domain/placeOrder.js
@@ -1,7 +1,10 @@
-// The order store is passed in: see src/infra/memoryOrderStore.js for the implementation.
-export function placeOrder({ orderStore }, customerId, lines) {
+import { pointsFor } from './loyalty.js';
+
+// Stores are passed in: see src/infra/ for the implementations.
+export function placeOrder({ orderStore, pointsStore }, customerId, lines) {
   const totalCents = lines.reduce((sum, l) => sum + l.unitCents * l.qty, 0);
   const order = { id: `ord_${orderStore.count() + 1}`, customerId, lines, totalCents };
   orderStore.save(order);
+  pointsStore.add(customerId, pointsFor(totalCents));
   return order;
 }
diff --git a/src/infra/memoryPointsStore.js b/src/infra/memoryPointsStore.js
new file mode 100644
index 0000000..e6361be
--- /dev/null
+++ b/src/infra/memoryPointsStore.js
@@ -0,0 +1,9 @@
+export function createMemoryPointsStore() {
+  const balances = new Map();
+  return {
+    add(customerId, points) {
+      balances.set(customerId, (balances.get(customerId) ?? 0) + points);
+    },
+    get(customerId) { return balances.get(customerId) ?? 0; },
+  };
+}
diff --git a/test/loyalty.test.js b/test/loyalty.test.js
new file mode 100644
