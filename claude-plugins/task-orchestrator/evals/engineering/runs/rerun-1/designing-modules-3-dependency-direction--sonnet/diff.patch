--- /dev/null
+++ b/test/loyalty.test.js
@@ -0,0 +1,30 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createApp } from '../src/app.js';
+import { pointsFor } from '../src/domain/loyalty.js';
+
+test('pointsFor floors to whole currency units', () => {
+  assert.equal(pointsFor(0), 0);
+  assert.equal(pointsFor(99), 0);
+  assert.equal(pointsFor(100), 1);
+  assert.equal(pointsFor(250), 2);
+});
+
+test('unknown customer has zero points', () => {
+  assert.equal(createApp().getPoints('nobody'), 0);
+});
+
+test('placing an order earns points', () => {
+  const app = createApp();
+  app.placeOrder('c1', [{ sku: 'a', unitCents: 300, qty: 2 }]);
+  assert.equal(app.getPoints('c1'), 6);
+});
+
+test('points accumulate across orders and stay per customer', () => {
+  const app = createApp();
+  app.placeOrder('c1', [{ sku: 'a', unitCents: 150, qty: 1 }]);
+  app.placeOrder('c1', [{ sku: 'a', unitCents: 250, qty: 1 }]);
+  app.placeOrder('c2', [{ sku: 'a', unitCents: 99, qty: 1 }]);
+  assert.equal(app.getPoints('c1'), 3);
+  assert.equal(app.getPoints('c2'), 0);
+});
