--- /dev/null
+++ b/test/backorders.test.js
@@ -0,0 +1,26 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createBackorder, backordersForOrder } from '../src/backorders/backorders.js';
+
+test('createBackorder holds the missing quantity as an open backorder', () => {
+  const b = createBackorder('o1', 'sku-a', 3);
+  assert.equal(b.orderId, 'o1');
+  assert.equal(b.sku, 'sku-a');
+  assert.equal(b.qty, 3);
+  assert.equal(b.status, 'open');
+});
+
+test('backordersForOrder lists only the given order backorders', () => {
+  createBackorder('o2', 'sku-a', 1);
+  createBackorder('o2', 'sku-b', 2);
+  createBackorder('o3', 'sku-a', 5);
+  assert.equal(backordersForOrder('o2').length, 2);
+  assert.equal(backordersForOrder('o3').length, 1);
+  assert.equal(backordersForOrder('none').length, 0);
+});
+
+test('createBackorder rejects non-positive or non-integer qty', () => {
+  assert.throws(() => createBackorder('o4', 'sku-a', 0), RangeError);
+  assert.throws(() => createBackorder('o4', 'sku-a', -1), RangeError);
+  assert.throws(() => createBackorder('o4', 'sku-a', 1.5), RangeError);
+});
