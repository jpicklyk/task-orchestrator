@@ -12,3 +12,10 @@ _In code_: `Shipment`, `shipments/`.
 The act of collecting one line's items from warehouse shelves for a Shipment.
 
 _In code_: `Pick`, `picks/`.
+
+## Backorder
+
+The quantity of an order line that a Pick could not collect because the shelf held too little stock. It is held against the Order and ships later, in a Shipment, once stock arrives.
+
+_Don't call it_: back-order, shortfall, pending item.
+_In code_: `Backorder`, `backorders/`.
diff --git a/src/backorders/backorders.js b/src/backorders/backorders.js
new file mode 100644
index 0000000..898be58
--- /dev/null
+++ b/src/backorders/backorders.js
@@ -0,0 +1,14 @@
+const backorders = new Map();
+
+export function createBackorder(orderId, sku, qty) {
+  if (!Number.isInteger(qty) || qty <= 0) {
+    throw new RangeError('backorder qty must be a positive integer');
+  }
+  const backorder = { id: `bo_${backorders.size + 1}`, orderId, sku, qty, status: 'open' };
+  backorders.set(backorder.id, backorder);
+  return backorder;
+}
+
+export function backordersForOrder(orderId) {
+  return [...backorders.values()].filter((b) => b.orderId === orderId);
+}
diff --git a/test/backorders.test.js b/test/backorders.test.js
new file mode 100644
