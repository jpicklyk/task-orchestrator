+++ b/src/config.js
@@ -0,0 +1,57 @@
+import { readFileSync } from 'node:fs';
+import { resolve } from 'node:path';
+
+export const DEFAULTS = Object.freeze({ host: '0.0.0.0', port: 8080, logLevel: 'info' });
+export const LOG_LEVELS = ['debug', 'info', 'warn', 'error'];
+
+export class ConfigError extends Error {
+  constructor(message) {
+    super(message);
+    this.name = 'ConfigError';
+  }
+}
+
+export function validateConfig(config) {
+  const { host, port, logLevel } = config;
+  if (!Number.isInteger(port) || port < 1 || port > 65535) {
+    throw new ConfigError(`Invalid "port": expected an integer from 1 to 65535, got ${JSON.stringify(port)}`);
+  }
+  if (typeof host !== 'string' || host.trim() === '') {
+    throw new ConfigError(`Invalid "host": expected a non-empty string, got ${JSON.stringify(host)}`);
+  }
+  if (!LOG_LEVELS.includes(logLevel)) {
+    throw new ConfigError(
+      `Invalid "logLevel": expected one of ${LOG_LEVELS.join(', ')}, got ${JSON.stringify(logLevel)}`,
+    );
+  }
+  return config;
+}
+
+// Reads a JSON config file (default: ./config.json). A missing file means "use defaults".
+export function loadConfig(file = 'config.json') {
+  const path = resolve(file);
+  let raw;
+  try {
+    raw = readFileSync(path, 'utf8');
+  } catch (err) {
+    if (err.code === 'ENOENT') return { ...DEFAULTS };
+    throw new ConfigError(`Cannot read config file ${path}: ${err.message}`);
+  }
+
+  let parsed;
+  try {
+    parsed = JSON.parse(raw);
+  } catch (err) {
+    throw new ConfigError(`Config file ${path} is not valid JSON: ${err.message}`);
+  }
+  if (parsed === null || typeof parsed !== 'object' || Array.isArray(parsed)) {
+    throw new ConfigError(`Config file ${path} must contain a JSON object`);
+  }
+
+  try {
+    return validateConfig({ ...DEFAULTS, ...parsed });
+  } catch (err) {
+    if (err instanceof ConfigError) throw new ConfigError(`${path}: ${err.message}`);
+    throw err;
+  }
+}
diff --git a/src/config.test.js b/src/config.test.js
new file mode 100644
index 0000000..a8bbb46
--- /dev/null
+++ b/src/config.test.js
@@ -0,0 +1,62 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtempSync, writeFileSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { loadConfig, ConfigError, DEFAULTS } from './config.js';
+
+function withFile(content, fn) {
+  const dir = mkdtempSync(join(tmpdir(), 'cfg-'));
+  const file = join(dir, 'config.json');
+  if (content !== undefined) writeFileSync(file, content);
+  try {
+    return fn(file);
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+}
+
+const load = (obj) => withFile(typeof obj === 'string' ? obj : JSON.stringify(obj), loadConfig);
+const rejects = (obj, re) => assert.throws(() => load(obj), (e) => e instanceof ConfigError && re.test(e.message));
+
+test('missing file yields defaults', () => {
+  assert.deepEqual(withFile(undefined, loadConfig), DEFAULTS);
+});
+
+test('empty object yields defaults', () => {
+  assert.deepEqual(load({}), DEFAULTS);
+});
+
+test('partial config is merged with defaults', () => {
+  assert.deepEqual(load({ port: 3000 }), { ...DEFAULTS, port: 3000 });
+});
+
+test('full valid config is used as-is', () => {
+  const cfg = { host: '127.0.0.1', port: 65535, logLevel: 'debug' };
+  assert.deepEqual(load(cfg), cfg);
+});
+
+test('invalid ports are rejected', () => {
+  for (const port of [0, 65536, -1, 1.5, '80', null, NaN]) rejects({ port }, /"port"/);
+});
+
+test('invalid hosts are rejected', () => {
+  for (const host of ['', '   ', 5, null]) rejects({ host }, /"host"/);
+});
+
+test('invalid log levels are rejected', () => {
+  for (const logLevel of ['verbose', 'INFO', 1, null]) rejects({ logLevel }, /"logLevel"/);
+});
+
+test('malformed JSON gives a clear error', () => {
+  rejects('{ not json', /not valid JSON/);
+});
+
+test('non-object JSON is rejected', () => {
+  rejects('[1,2]', /must contain a JSON object/);
+  rejects('null', /must contain a JSON object/);
+});
+
+test('error message names the file', () => {
+  rejects({ port: 0 }, /config\.json/);
+});
