diff --git a/src/orders/orders.js b/src/orders/orders.js
index d0c4ae0..d7f72c4 100644
--- a/src/orders/orders.js
+++ b/src/orders/orders.js
@@ -9,3 +9,16 @@ export function createOrder(customerId, lines) {
 export function ordersForCustomer(customerId) {
   return orders.filter((o) => o.customerId === customerId);
 }
+
+// Lines are assumed to look like { unitPrice, quantity }.
+export function orderTotal(order) {
+  return order.lines.reduce((sum, l) => sum + l.unitPrice * l.quantity, 0);
+}
+
+// Newest first; ties (same timestamp) resolve to most recently created first.
+export function orderHistory(customerId) {
+  return ordersForCustomer(customerId)
+    .map((o, i) => ({ o, i }))
+    .sort((a, b) => b.o.createdAt.localeCompare(a.o.createdAt) || b.i - a.i)
+    .map(({ o }) => ({ id: o.id, date: o.createdAt, total: orderTotal(o) }));
+}
diff --git a/test/orders.test.js b/test/orders.test.js
