diff --git a/claude-plugins/task-orchestrator/scripts/lib/meters.mjs b/claude-plugins/task-orchestrator/scripts/lib/meters.mjs
index 859a0dc..5ea1d03 100644
--- a/claude-plugins/task-orchestrator/scripts/lib/meters.mjs
+++ b/claude-plugins/task-orchestrator/scripts/lib/meters.mjs
@@ -46,3 +46,17 @@ export function transcriptMeters(text) {
   if (usageById.size === 0) return undefined
   return sumUsage(usageById.values())
 }
+
+/**
+ * cacheShare(text) -> cacheRead / (input + cacheWrite + cacheRead), a number from 0 to 1, over a
+ * subagent transcript's JSONL text (same one-count-per-message.id measure as transcriptMeters), or
+ * undefined when the transcript carries no usage. A transcript whose input side is all zero has no
+ * share to report and also returns undefined.
+ */
+export function cacheShare(text) {
+  const m = transcriptMeters(text)
+  if (!m) return undefined
+  const inputSide = m.input + m.cacheWrite + m.cacheRead
+  if (inputSide === 0) return undefined
+  return m.cacheRead / inputSide
+}
diff --git a/claude-plugins/task-orchestrator/scripts/tests/cache-share.test.mjs b/claude-plugins/task-orchestrator/scripts/tests/cache-share.test.mjs
new file mode 100644
index 0000000..e503e81
--- /dev/null
+++ b/claude-plugins/task-orchestrator/scripts/tests/cache-share.test.mjs
@@ -0,0 +1,52 @@
+// cache-share.test.mjs -- cacheShare(text) in lib/meters.mjs: cacheRead / (input + cacheWrite + cacheRead),
+// one count per message.id (last line of an id wins). Expected values are hand-summed above each case.
+
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+
+import { cacheShare } from '../lib/meters.mjs'
+
+const rec = (id, input, cacheWrite, cacheRead, output) => JSON.stringify({
+  type: 'assistant',
+  message: {
+    id,
+    usage: {
+      input_tokens: input,
+      cache_creation_input_tokens: cacheWrite,
+      cache_read_input_tokens: cacheRead,
+      output_tokens: output,
+    },
+  },
+})
+
+test('share over two messages', () => {
+  // input side: m1 100+200+0 = 300, m2 50+0+700 = 750 -> 1050; read 700 -> 2/3
+  const text = [rec('m1', 100, 200, 0, 10), rec('m2', 50, 0, 700, 20)].join('\n')
+  assert.equal(cacheShare(text), 700 / 1050)
+})
+
+test('output tokens never enter the denominator', () => {
+  // input side 10+0+30 = 40, read 30 -> 0.75 whatever the output
+  assert.equal(cacheShare(rec('m1', 10, 0, 30, 99999)), 0.75)
+})
+
+test('a repeated message.id counts once, the last line wins', () => {
+  // last m1 line: 20+0+80 = 100, read 80 -> 0.8 (the first line alone would give 0)
+  const text = [rec('m1', 100, 0, 0, 1), rec('m1', 20, 0, 80, 5)].join('\n')
+  assert.equal(cacheShare(text), 0.8)
+})
+
+test('no cache reads gives 0; only cache reads gives 1', () => {
+  assert.equal(cacheShare(rec('m1', 5, 5, 0, 1)), 0)
+  assert.equal(cacheShare(rec('m1', 0, 0, 7, 1)), 1)
+})
+
+test('no usage, empty or garbage text gives undefined', () => {
+  assert.equal(cacheShare(''), undefined)
+  assert.equal(cacheShare(undefined), undefined)
+  assert.equal(cacheShare('not json "assistant"\n{"type":"user"}'), undefined)
+})
+
+test('a zero input side gives undefined, not NaN', () => {
+  assert.equal(cacheShare(rec('m1', 0, 0, 0, 12)), undefined)
+})
