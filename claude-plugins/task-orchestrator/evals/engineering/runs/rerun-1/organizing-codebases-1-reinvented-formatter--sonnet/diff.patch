@@ -0,0 +1,17 @@
+import { formatAmount } from './money.js';
+
+// Returns a text block: one row per line with its amount, then subtotal, tax and total.
+export function summarizeInvoice(invoice) {
+  const { lines, currency, subtotalCents, taxCents, totalCents } = invoice;
+  const fmt = (cents) => formatAmount(cents, currency);
+  const rows = lines.map((l) => {
+    const label = l.description ?? l.name ?? 'Item';
+    return `${label} x${l.qty}: ${fmt(l.unitCents * l.qty)}`;
+  });
+  return [
+    ...rows,
+    `Subtotal: ${fmt(subtotalCents)}`,
+    `Tax: ${fmt(taxCents)}`,
+    `Total: ${fmt(totalCents)}`,
+  ].join('\n');
+}
diff --git a/test/summary.test.js b/test/summary.test.js
