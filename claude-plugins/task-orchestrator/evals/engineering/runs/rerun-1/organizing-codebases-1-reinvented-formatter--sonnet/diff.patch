+++ b/test/summary.test.js
@@ -0,0 +1,25 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/billing/invoice.js';
+import { summarizeInvoice } from '../src/billing/summary.js';
+
+test('summarizeInvoice lists lines, subtotal, tax and total as prices', () => {
+  const invoice = createInvoice(
+    'Acme',
+    [
+      { description: 'Widget', unitCents: 1250, qty: 2 },
+      { description: 'Gadget', unitCents: 99900, qty: 1 },
+    ],
+    1000,
+  );
+  assert.equal(
+    summarizeInvoice(invoice),
+    [
+      'Widget x2: $25.00',
+      'Gadget x1: $999.00',
+      'Subtotal: $1,024.00',
+      'Tax: $102.40',
+      'Total: $1,126.40',
+    ].join('\n'),
+  );
+});
