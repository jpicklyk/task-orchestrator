@@ -9,3 +9,16 @@ export function createOrder(customerId, lines) {
 export function ordersForCustomer(customerId) {
   return orders.filter((o) => o.customerId === customerId);
 }
+
+// Line shape assumed: { unitPrice, quantity } (quantity defaults to 1).
+export function orderTotal(order) {
+  return order.lines.reduce((sum, l) => sum + l.unitPrice * (l.quantity ?? 1), 0);
+}
+
+// Past orders for a customer, newest first, as { id, date, total }.
+export function orderHistory(customerId) {
+  return ordersForCustomer(customerId)
+    .map((o, i) => ({ o, i }))
+    .sort((a, b) => b.o.createdAt.localeCompare(a.o.createdAt) || b.i - a.i)
+    .map(({ o }) => ({ id: o.id, date: o.createdAt, total: orderTotal(o) }));
+}
