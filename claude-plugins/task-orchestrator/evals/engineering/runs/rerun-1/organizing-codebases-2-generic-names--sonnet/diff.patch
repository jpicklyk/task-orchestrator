@@ -0,0 +1,12 @@
+/**
+ * Shipping cost in cents for a total weight in kilograms.
+ * <= 1 kg: 500; <= 5 kg: 900; above: 900 + 200 per further whole or partial kg.
+ */
+export function shippingCost(weightKg) {
+  if (typeof weightKg !== 'number' || !Number.isFinite(weightKg) || weightKg < 0) {
+    throw new RangeError('weightKg must be a non-negative finite number');
+  }
+  if (weightKg <= 1) return 500;
+  if (weightKg <= 5) return 900;
+  return 900 + 200 * Math.ceil(weightKg - 5);
+}
diff --git a/test/cost.test.js b/test/cost.test.js
