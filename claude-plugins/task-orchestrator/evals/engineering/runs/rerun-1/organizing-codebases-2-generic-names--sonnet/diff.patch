@@ -0,0 +1,28 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { shippingCost } from '../src/shipping/cost.js';
+
+test('up to 1 kg costs 500', () => {
+  assert.equal(shippingCost(0), 500);
+  assert.equal(shippingCost(0.5), 500);
+  assert.equal(shippingCost(1), 500);
+});
+
+test('over 1 kg up to 5 kg costs 900', () => {
+  assert.equal(shippingCost(1.01), 900);
+  assert.equal(shippingCost(3), 900);
+  assert.equal(shippingCost(5), 900);
+});
+
+test('above 5 kg adds 200 per whole or partial kg', () => {
+  assert.equal(shippingCost(5.01), 1100);
+  assert.equal(shippingCost(6), 1100);
+  assert.equal(shippingCost(6.5), 1300);
+  assert.equal(shippingCost(10), 1900);
+});
+
+test('rejects invalid weights', () => {
+  assert.throws(() => shippingCost(-1), RangeError);
+  assert.throws(() => shippingCost(NaN), RangeError);
+  assert.throws(() => shippingCost('2'), RangeError);
+});
