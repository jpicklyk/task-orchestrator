+#!/usr/bin/env node
+// UserPromptSubmit — adds a one-line planning reminder the first time it runs in a session.
+// Each invocation is a new process, so "first" is an exclusive-create marker under the session's
+// temp directory. Later invocations, and any input without a session id, emit `{}`.
+import { emit, contextOutput } from "./lib/emit.mjs";
+import { readHookInput } from "./lib/stdin.mjs";
+import { createMarkerOnce, sessionMarkerPath } from "./lib/markers.mjs";
+
+const REMINDER = "Check items_read next before you plan.";
+
+function main() {
+  const input = readHookInput();
+  const sessionId = input && typeof input.session_id === "string" ? input.session_id : "";
+  if (!sessionId) return {};
+  if (!createMarkerOnce(sessionMarkerPath(sessionId, "plan-reminder"))) return {};
+  return contextOutput("UserPromptSubmit", REMINDER);
+}
+
+let out = {};
+try {
+  out = main();
+} catch {
+  out = {};
+}
+emit(out);
