<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender for ALL levels, routed to stderr as one JSON object per line —
         keeps stdout exclusively for MCP JSON-RPC messages (stdio transport). Level is
         controlled only by the root logger below (${LOG_LEVEL:-INFO}); no ThresholdFilter here. -->
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder class="io.github.jpicklyk.mcptask.current.infrastructure.logging.Iso8601JsonEncoder"/>
    </appender>

    <!-- Root logger: stderr only. Opt-in file logging (LOG_FILE) is attached PROGRAMMATICALLY by
         io.github.jpicklyk.mcptask.current.infrastructure.logging.LogFileAppenderInstaller, called
         from CurrentMain — see that class's KDoc for why (a logback-core 1.5.32 Joran quirk makes
         the Janino-free <if><condition class="..."> XML form silently never attach the appender
         even with the property correctly set). Nothing here ever targets stdout. -->
    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="STDERR"/>
    </root>

    <!-- Suppress verbose MCP SDK internals -->
    <logger name="io.modelcontextprotocol" level="WARN"/>
</configuration>
